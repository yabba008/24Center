{
  "name": "24Center",
  "version": "1.2.5",
  "description": "An entire suite designed for the PTFS Roblox game and the ATC24 group.",
  "author": "Landon Kerns <kerns.landon@icloud.com>",
  "license": "GPL-3.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.2424.24center",
    "productName": "24Center",
    "files": [
      "**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": { 
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Utility",
      "icon": "build/icons"
    },
    "directories": { 
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^26.0.12"
  }
}